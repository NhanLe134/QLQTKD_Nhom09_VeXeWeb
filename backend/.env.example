# Mẫu cho backend/.env. File .env thật (có mật khẩu) được gửi riêng trong nhóm,
# KHÔNG lấy từ Git và KHÔNG commit. Mọi giá trị CHANGE_ME phải được thay.

# ---- CSDL dùng chung: Supabase (PostgreSQL) ----
# Lấy ở Supabase Dashboard → Connect → "Session pooler" (cổng 5432, có IPv4).
# - Đổi tiền tố postgresql:// thành postgresql+asyncpg://
# - User có dạng postgres.<project-ref>; mật khẩu có ký tự đặc biệt phải URL-encode
# - KHÔNG dùng cổng 6543 (transaction pooler): backend sẽ báo lỗi
# - KHÔNG thêm ?sslmode=...: SSL tự bật cho CSDL không ở máy local
# App, Alembic và seed dùng biến này.
DATABASE_URL=postgresql+asyncpg://postgres.CHANGE_ME:CHANGE_ME@CHANGE_ME.pooler.supabase.com:5432/postgres

# ---- CSDL test: PostgreSQL Docker trên máy (compose.yaml) ----
# Bắt buộc khi chạy pytest. Host phải là 127.0.0.1 hoặc localhost, tên CSDL kết
# thúc bằng _test; pytest tự tạo/xóa CSDL này cho mỗi test.
# Dùng 127.0.0.1: trên Windows, localhost thử IPv6 trước nên mỗi kết nối chậm 2 giây.
# User và mật khẩu trùng POSTGRES_USER, POSTGRES_PASSWORD bên dưới.
TEST_DATABASE_URL=postgresql+asyncpg://vexe:CHANGE_ME@127.0.0.1:5432/vexe_test

# Chỉ người phụ trách CSDL đặt =1 khi thật sự cần alembic downgrade trên Supabase.
# ALLOW_REMOTE_DOWNGRADE=1

# ---- Ứng dụng ----
# Thời gian giữ ghế (phút); đếm ngược 5 phút của QR chuyển khoản chỉ hiển thị ở frontend
SEAT_HOLD_MINUTES=10

# Job nhả ghế giữ quá hạn, chạy nền cùng backend. Nhiều máy cùng chạy trên Supabase
# vẫn an toàn (SKIP LOCKED, giờ lấy từ CSDL); muốn tắt job trên máy mình thì đặt false.
# pytest luôn tắt job. Máy chạy backend cần bật đồng bộ giờ tự động: giữ ghế dùng giờ máy.
RELEASE_JOB_ENABLED=true
# Chu kỳ quét (giây)
RELEASE_JOB_INTERVAL_SECONDS=30

# Khóa ký JWT (bắt buộc, tối thiểu 32 ký tự). Tạo bằng: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
# Phiên đăng nhập hết hạn sau số phút này (BR-BUS-05)
ACCESS_TOKEN_MINUTES=60

# Origin của frontend được gọi API (CORS), cách nhau bằng dấu phẩy; mặc định là Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mật khẩu chung của 4 tài khoản mẫu (khach_mau, nha_xe_mau, tai_xe_mau, admin_mau),
# dùng khi chạy seed (app/db/seed.py). Chỉ cho CSDL local; admin trên Supabase dùng
# mật khẩu riêng, thêm tay theo docs/API.md
SEED_USER_PASSWORD=CHANGE_ME

# ---- Giới hạn đăng nhập sai (lưu trong bộ nhớ tiến trình, xem docs/API.md) ----
# Sai quá số lần này trong LOGIN_LOCKOUT_MINUTES phút (theo tên đăng nhập + IP) → 429
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# Số proxy tin cậy đứng trước backend. 0 = bỏ qua X-Forwarded-For (chạy trên máy).
# Khi deploy Render PHẢI đặt đúng số hop đã kiểm tra (thường là 1), xem docs/API.md
TRUSTED_PROXY_HOPS=0

# ---- SePay (thanh toán chuyển khoản, task #11) ----
# Khóa SePay gửi kèm header Authorization khi gọi webhook. Lấy/đặt trên
# SePay Dashboard; thiếu biến này thì webhook trả 503.
SEPAY_WEBHOOK_SECRET=CHANGE_ME
# Tài khoản nhận tiền của nhà xe để dựng ảnh QR (VietQR). Thiếu 2 biến đầu
# thì pay-sepay trả 503. SEPAY_BANK_BIN là mã BIN ngân hàng (vd MB = 970422).
SEPAY_BANK_BIN=CHANGE_ME
SEPAY_ACCOUNT_NO=CHANGE_ME
SEPAY_ACCOUNT_NAME=CHANGE_ME
# Cửa sổ chuyển khoản hiển thị cho khách (phút); server chấp nhận tiền đến
# trong toàn bộ thời gian giữ chỗ
SEPAY_QR_MINUTES=5

# ---- Tự động hoá n8n (luồng Đổi vé) ----
N8N_EXCHANGE_WEBHOOK_URL=http://localhost:5678/webhook/doi-ve
N8N_BOOKING_WEBHOOK_URL=http://localhost:5678/webhook/dat-ve

# ---- Container PostgreSQL cho test (compose.yaml đọc các biến này) ----
POSTGRES_USER=vexe
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vexe

# ---- SMTP Gửi email vé điện tử (task #10/BR-BUS-35) ----
# Cấu hình SMTP Gmail hoặc máy chủ khác. Để trống thì chạy giả lập ghi log (dev/test).
# Với Gmail: bật 2FA, tạo Mật khẩu ứng dụng 16 ký tự, cổng 587 (TLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="VexeApp <your-email@gmail.com>"
