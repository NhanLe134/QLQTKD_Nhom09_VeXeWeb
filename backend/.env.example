# Sao chép thành backend/.env rồi thay CHANGE_ME bằng mật khẩu thật.
# Mật khẩu trong DATABASE_URL phải trùng với POSTGRES_PASSWORD.

# Ứng dụng
# Dùng 127.0.0.1 như compose.yaml: trên Windows, localhost thử IPv6 trước nên mỗi kết nối chậm 2 giây
DATABASE_URL=postgresql+asyncpg://vexe:CHANGE_ME@127.0.0.1:5432/vexe
SEAT_HOLD_MINUTES=5

# Mật khẩu chung của 3 tài khoản mẫu, dùng khi chạy seed (app/db/seed.py)
SEED_USER_PASSWORD=CHANGE_ME

# Container PostgreSQL (compose.yaml)
POSTGRES_USER=vexe
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vexe
