# Mẫu cho frontend/.env. File .env thật được gửi riêng trong nhóm, KHÔNG commit.
# Chỉ đặt biến có tiền tố VITE_ ở đây: Vite đưa chúng vào mã chạy trên trình duyệt,
# nên TUYỆT ĐỐI không ghi mật khẩu, khóa bí mật hay chuỗi kết nối CSDL.

# Địa chỉ backend FastAPI (uv run uvicorn app.main:app --reload).
# Dùng 127.0.0.1 thay vì localhost để tránh chậm do thử IPv6 trên Windows.
VITE_API_URL=http://127.0.0.1:8000
